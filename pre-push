#!/bin/sh

# Pre-push hook: show commits about to be pushed and ask for confirmation.

remote="$1"
url="$2"

zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')

# Collect all ref updates from stdin so we can display them.
refs=""
while read local_ref local_oid remote_ref remote_oid
do
	refs="$refs
$local_ref $local_oid $remote_ref $remote_oid"
done

# Strip leading blank line.
refs=$(echo "$refs" | sed '/^$/d')

if test -z "$refs"; then
	exit 0
fi

# Push without confirmation to remotes listed (space separated) in the
# hooks.pushNoConfirm git config setting.
for r in $(git config --get hooks.pushNoConfirm)
do
	test "$r" = "$remote" && exit 0
done

echo ""
echo "========== Pushing to $remote ($url) =========="
echo ""

echo "$refs" | while read local_ref local_oid remote_ref remote_oid
do
	if test "$local_oid" = "$zero"; then
		echo "  DELETE  $remote_ref"
		echo ""
		continue
	fi

	if test "$remote_oid" = "$zero"; then
		# New branch — show all commits reachable from it but not from
		# any existing remote branch, to avoid listing the entire history.
		range=$(git rev-parse --short "$local_oid")
		log_range="$local_oid --not --remotes=$remote"
		echo "  NEW BRANCH  $local_ref -> $remote_ref"
	else
		range="$(git rev-parse --short "$remote_oid")..$(git rev-parse --short "$local_oid")"
		log_range="$remote_oid..$local_oid"
		echo "  UPDATE  $local_ref -> $remote_ref  ($range)"
	fi

	commits=$(git log --oneline --no-decorate $log_range --)
	if test -n "$commits"; then
		echo ""
		echo "$commits" | sed 's/^/    /'
	else
		echo "    (no new commits)"
	fi
	echo ""
done

# We need a terminal for the prompt — stdin was consumed by the ref list.
exec < /dev/tty

printf "Proceed with push? [y/N] "
read answer
case "$answer" in
	[yY]|[yY][eE][sS]) exit 0 ;;
	*) echo "Push aborted."; exit 1 ;;
esac
